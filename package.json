{
  "name": "visibilio-cloudflare-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Pages Functions template for the Visibilio publishing contract. Fork or clone to host a Visibilio-publishable site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VisibilioAI/visibilio-cloudflare-worker.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint functions tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "vendor:schema": "tsx scripts/vendor-schema.ts",
    "vendor:check": "tsx scripts/check-vendored-schema.ts",
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  }
}
